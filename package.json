{
  "name": "masar-english",
  "version": "0.1.0",
  "private": true,
  "description": "A free English-learning game for Arabic speakers, A1 to C2. Static, dependency-free, works offline.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "node tests/serve.mjs",
    "dev": "node tests/serve.mjs",
    "test": "npm run test:syntax && npm run test:content && npm run test:unit",
    "test:syntax": "node tests/syntax.mjs",
    "test:content": "node tests/validate-content.mjs",
    "test:unit": "node --test tests/engine.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test:all": "npm test && npm run test:e2e"
  },
  "engines": { "node": ">=20" },
  "dependencies": {},
  "devDependencies": {}
}
